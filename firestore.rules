rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedMailbox(data, userId, mailboxId) {
      return data.keys().hasAll(['mailboxId', 'ownerUid', 'address', 'createdAt'])
        && data.keys().hasOnly(['mailboxId', 'ownerUid', 'address', 'label', 'createdAt'])
        && data.mailboxId is string
        && isValidId(data.mailboxId)
        && data.mailboxId == mailboxId
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.ownerUid == userId
        && data.ownerUid == request.auth.uid
        && data.address is string
        && data.address.size() >= 5
        && data.address.size() <= 254
        && (!('label' in data) || (data.label is string && data.label.size() <= 80))
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /mailboxes/{mailboxId} {
        allow get: if isValidId(userId)
          && isValidId(mailboxId)
          && isOwner(userId)
          && (resource == null || existing().ownerUid == request.auth.uid)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isVerified()
          && request.auth.uid == userId
          && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(mailboxId)
          && isOwner(userId)
          && isValidSavedMailbox(incoming(), userId, mailboxId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(mailboxId)
          && isOwner(userId)
          && isValidSavedMailbox(incoming(), userId, mailboxId)
          && incoming().mailboxId == existing().mailboxId
          && incoming().ownerUid == existing().ownerUid
          && incoming().address == existing().address
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['label'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId)
          && isValidId(mailboxId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}
