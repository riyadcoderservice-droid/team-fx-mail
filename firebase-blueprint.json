{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Gmail user profile for TEAM FX Premium Mail.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "SavedMailbox": {
      "title": "SavedMailbox",
      "description": "Disposable temp mail address saved under a user's Gmail account.",
      "type": "object",
      "properties": {
        "mailboxId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "address": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 254
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["mailboxId", "ownerUid", "address", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile documents keyed by Firebase Auth UID."
    },
    "/users/{userId}/mailboxes/{mailboxId}": {
      "schema": { "$ref": "#/entities/SavedMailbox" },
      "description": "Saved temporary email addresses belonging to the parent user."
    }
  }
}
